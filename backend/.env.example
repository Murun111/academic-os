# backend/.env.example — checked in, no real secrets
# Copy to backend/.env and fill in real values

# === Apple iCloud (Panel B + E) ===
# Generate app-specific password: https://appleid.apple.com → App-Specific Passwords
APPLE_ICLOUD_EMAIL=your@email.com
APPLE_CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_CALDAV_URL=https://caldav.icloud.com

# Apple Reminders list name (auto-created on first run)
APPLE_REMINDERS_LIST=Agentic OS Inbox

# === LLM providers ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:latest

# Optional: Anthropic fallback. Leave empty to disable.
ANTHROPIC_API_KEY=

# Set to 1 to force daily-brief to use Anthropic (premium quality).
DAILY_BRIEF_PREMIUM=0

# === Server ===
BIND_HOST=127.0.0.1
BIND_PORT=7878
LOG_LEVEL=INFO

# === Instagram growth dashboard (ig.* tools) ===
# Supabase project behind ig-growth-dashboard.netlify.app; leave empty to disable.
IG_SUPABASE_URL=
IG_SUPABASE_ANON_KEY=
IG_DASH_EMAIL=
IG_DASH_PASSWORD=
